PORT=10000
APP_NAME=ai-webapp-api
APP_ENV=development
CORS_ORIGIN=http://localhost:5173
CRON_SECRET=replace_with_long_random_secret
API_BASE_URL=http://localhost:10000
WORKER_INTERVAL_SECONDS=60
CRON_JOB_NAME=scheduled-maintenance

# AI classification (Dedup announcements)
AI_CLASSIFIER_ENABLED=false
AI_CRITERIA_VERSION=v1
AI_MAX_ITEMS_PER_CRON=120
AI_CLASSIFICATION_CONCURRENCY=2
AI_PDF_FETCH_TIMEOUT_MS=30000
AI_PRIMARY_MAX_PAGES=4
AI_ESCALATION_MAX_PAGES=12
AI_ESCALATION_CONFIDENCE_THRESHOLD=0.8
AI_MIN_READABLE_CHARS=700
AI_FAILURE_RETRY_HOURS=24
OPENAI_API_KEY=
AI_OPENAI_STAGE1_MODEL=gpt-4o-mini
AI_OPENAI_STAGE2_MODEL=gpt-4o-mini
GEMINI_API_KEY=
AI_GEMINI_STAGE1_MODEL=gemini-2.5-flash-lite
AI_GEMINI_STAGE2_MODEL=gemini-2.5-flash
CLAUDE_API_KEY=
AI_ANTHROPIC_STAGE1_MODEL=claude-3-5-haiku-latest
AI_ANTHROPIC_STAGE2_MODEL=claude-3-5-sonnet-latest
