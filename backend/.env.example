PORT=10000
APP_NAME=ai-webapp-api
APP_ENV=development
CORS_ORIGIN=http://localhost:5173
CRON_SECRET=replace_with_long_random_secret
API_BASE_URL=http://localhost:10000
WORKER_INTERVAL_SECONDS=60
WORKER_HEARTBEAT_SECONDS=20
WORKER_REQUEST_TIMEOUT_MS=180000
WORKER_LOOP_DELAY_MS=200
WORKER_ID=
WORKER_ALLOWED_JOB_TYPES=ai-classification
CRON_JOB_NAME=scheduled-maintenance
DATABASE_URL=
DATABASE_SSL_MODE=disable
DATABASE_MAX_CONNECTIONS=10
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000

# AI classification (Dedup announcements)
AI_CLASSIFIER_ENABLED=false
AI_CRITERIA_VERSION=v2
AI_LABELS_STORAGE_FILE=data/announcement_ai_labels.json
AI_REVIEWS_STORAGE_FILE=data/announcement_ai_reviews.json
AI_SUGGESTIONS_STORAGE_FILE=data/announcement_ai_suggestions.json
AI_PROMPT_LEARNING_MIN_EXAMPLES=2
AI_PROMPT_LEARNING_MAX_RULES=8
AI_MAX_ITEMS_PER_CRON=120
# Legacy async worker tuning (used only if legacy worker endpoints are enabled in code)
AI_ASYNC_CHUNK_SIZE=10
AI_ASYNC_MAX_LOOPS=120
AI_CLASSIFICATION_CONCURRENCY=2
AI_PDF_FETCH_TIMEOUT_MS=30000
AI_PDF_FETCH_MAX_ATTEMPTS=3
AI_PDF_PARSE_MAX_ATTEMPTS=2
AI_PDF_RETRY_DELAY_MS=1200
AI_PDF_MIN_BYTES=1024
AI_PRIMARY_MAX_PAGES=4
AI_ESCALATION_MAX_PAGES=12
AI_ESCALATION_CONFIDENCE_THRESHOLD=0.8
AI_MIN_READABLE_CHARS=700
AI_FAILURE_RETRY_HOURS=24
AI_TRANSIENT_FAILURE_RETRY_MINUTES=60
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_GEMINI_STAGE1_MODEL=gemini-2.5-flash-lite
AI_GEMINI_STAGE2_MODEL=gemini-2.5-flash
CLAUDE_API_KEY=
AI_ANTHROPIC_STAGE1_MODEL=claude-3-5-haiku-latest
AI_ANTHROPIC_STAGE2_MODEL=claude-3-5-sonnet-latest
